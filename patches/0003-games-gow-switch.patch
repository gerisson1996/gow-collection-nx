+// Ponte do mod menu do Switch (nx_menu.cpp, thread Render). As opções do jogo vão pelos mesmos pedidos do menu de
+// pausa e valem no game_options_tick (depois que o menu fecha); o escalonamento vale na hora.
+#include "nx_menu.h"
+namespace nxopt {
+uint32_t get(int id) {
+    const auto &o = vt::g_opt;
+    switch (id) {
+    case RES: return o.scale ? o.scale : 1;
+    case DRS: return o.drs;
+    case SHARP: return o.sharp;
+    case RES_DOCK: return o.scale_dock;
+    case AA: return o.aa;
+    case UPSCALE: return o.upscaler;
+    case ANISO: return o.aniso;
+    case GAMMA: return o.gamma;
+    case SAT: return o.sat;
+    case VIB: return o.vib;
+    case DITHER: return o.dither;
+    case LANG: return o.lang;
+    case FPS: return o.fps;
+    case VSYNC: return o.vsync;
+    case COUNTER: return o.counter;
+    case TEX: return o.tex;
+    case QTE: return o.auto_qte;
+    case HPBARS: return o.hp_bars;
+    case CH_HP: return o.inf_health;
+    case CH_MP: return o.inf_magic;
+    case CH_RAGE: return o.inf_rage;
+    case FGEN: return o.fgen;
+    case GPUDIAG: return gvk::gpu_diag() > 0;
+    case FGFLOW: return gvk::frame_gen_flow();
+    }
+    return 0;
+}
+void set(int id, uint32_t v) {
+    using namespace vt;
+    const uint32_t b = v ? 2u : 1u;
+    switch (id) {
+    case RES: g_req_res = v; break;
+    case DRS: g_opt.drs = v != 0, gvk::set_dynamic_res(g_opt.drs, g_opt.fps), g_req_save = 1; break;
+    case SHARP: g_opt.sharp = v > 10 ? 10 : v, apply_gfx(), g_req_save = 1; break;
+    case RES_DOCK: g_req_resd = (v <= 6 ? v : 0) + 1; break;
+    case AA: g_opt.aa = v ? 1 : 0, apply_gfx(), g_req_save = 1; break;
+    case UPSCALE: g_opt.upscaler = v ? 1 : 0, apply_gfx(), g_req_save = 1; break;
+    case ANISO: g_opt.aniso = v >= 16 ? 16 : v >= 8 ? 8 : v >= 4 ? 4 : v >= 2 ? 2 : 1, apply_gfx(), g_req_save = 1; break;
+    case GAMMA: g_opt.gamma = v > 8 ? 8 : v, apply_gfx(), g_req_save = 1; break;
+    case SAT: g_opt.sat = v > 8 ? 8 : v, apply_gfx(), g_req_save = 1; break;
+    case VIB: g_opt.vib = v > 4 ? 4 : v, apply_gfx(), g_req_save = 1; break;
+    case DITHER: g_opt.dither = v ? 1 : 0, apply_gfx(), g_req_save = 1; break;
+    case LANG: g_opt.lang = v <= 2 ? v : 0, g_opt.lang_raw = (g_opt.lang == 2 ? "es" : g_opt.lang == 1 ? "en" : "pt"), g_req_save = 1; break;
+    case FPS: g_req_fps = v; break;
+    case VSYNC: g_req_vsync = b; break;
+    case COUNTER: g_req_cnt = b; break;
+    case TEX: g_req_tex = b; break;
+    case QTE: g_req_qte = b; break;
+    case HPBARS: g_req_ehp = b; break;
+    case CH_HP: g_req_hp = b; break;
+    case CH_MP: g_req_mp = b; break;
+    case CH_RAGE: g_req_rage = b; break;
+    case FGEN:
+        // o quadro gerado entra entre dois reais: o jogo fica em 30 e a tela em 60
+        g_opt.fgen = v <= 2 && gvk::frame_gen_available(v) ? v : 0, gvk::set_frame_gen(g_opt.fgen), g_req_save = 1;
+        if (g_opt.fgen && g_opt.fps != 1) g_req_fps = 1;
+        break;
+    case GPUDIAG: gvk::set_gpu_diag(v != 0); break;
+    case FGFLOW: gvk::set_frame_gen_flow(v), g_req_save = 1; break;
+    }
+}
+bool available(int id) {
+#ifdef GOW_GAME_GOW2
+    if (id == FGEN || id == FGFLOW) return false; // sem geração de quadros no GoW2 (ver init)
+#endif
+    if (id == FGEN) return gvk::frame_gen_available(1) || gvk::frame_gen_available(2);
+    if (id == GPUDIAG) return gvk::gpu_diag() >= 0;
+    if (id == FGFLOW) return gvk::frame_gen_available(1) || gvk::frame_gen_available(2);
+    return id != TEX || vt::texpack_available();
+}
+} // namespace nxopt
